{
  "name": "goosialize/goosialize-google",
  "description": "Google product integrations for Grav CMS, starting with GA4 reporting.",
  "type": "grav-plugin",
  "license": "MIT",
  "require": {
    "google/analytics-admin": "^0.32",
    "google/analytics-data": "^0.24",
    "google/auth": "^1.53",
    "guzzlehttp/guzzle": "^7.8.2 <8.0",
    "guzzlehttp/psr7": "^2.6.3 <3.0",
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Goosialize\\Google\\": "classes/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
